# InstantDB (https://instantdb.com) — create an app, then copy its App ID + Admin token.
NEXT_PUBLIC_INSTANT_APP_ID=
INSTANT_ADMIN_TOKEN=

# Secret used to sign CLI / extension tokens (min 32 chars). Generate: openssl rand -hex 32
CLI_JWT_SECRET=

# Secret for the Vercel Cron cleanup endpoint (min 16 chars). Generate: openssl rand -hex 16
CRON_SECRET=

# Optional: Resend API key for vault invitation emails (invitations still work without it).
RESEND_API_KEY=

# Optional: Upstash Redis for distributed rate limiting (falls back to in-memory if unset).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
