{
  "expo": {
    "name": "Vaultix",
    "slug": "vaultix",
    "scheme": "vaultix",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FAFBF8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ts.mila.vaultix"
    },
    "android": {
      "package": "ts.mila.vaultix",
      "adaptiveIcon": {
        "backgroundColor": "#FAFBF8"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-font", "./plugins/withVaultixAutofill"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
