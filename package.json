{
  "name": "vaultix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:web": "turbo run dev --filter=@vaultix/web",
    "build:web": "turbo run build --filter=@vaultix/web",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.2"
    }
  }
}
