{
  "manifest_version": 3,
  "name": "Vaultix Password Manager",
  "version": "1.0.0",
  "description": "Secure password manager for Chrome - store and autofill your passwords",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content/content.js"],
      "run_at": "document_end"
    }
  ]
}